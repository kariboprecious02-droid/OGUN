# Ogun Payment Infrastructure Platform - Environment Configuration

# Runtime
NODE_ENV=development
PORT=4000
LOG_LEVEL=debug
OGUN_ENV=sandbox

# Base URLs
OGUN_API_BASE_URL=http://localhost:4000/v1
OGUN_SANDBOX_BASE_URL=https://sandbox.ogun.com/v1
OGUN_PRODUCTION_BASE_URL=https://api.ogun.com/v1

# PostgreSQL
DATABASE_URL=postgres://ogun:ogun@localhost:5432/ogun_dev

# Redis
REDIS_URL=redis://localhost:6379/0

# Safaricom Daraja (M-Pesa Collections)
SAFARICOM_ENV=sandbox
SAFARICOM_CONSUMER_KEY=
SAFARICOM_CONSUMER_SECRET=
SAFARICOM_SHORTCODE=174379
SAFARICOM_PASSKEY=
SAFARICOM_CALLBACK_URL=https://sandbox.ogun.com/v1/webhooks/safaricom
SAFARICOM_BASE_URL=https://sandbox.safaricom.co.ke

# Paystack (Airtel Collections + All Payouts)
PAYSTACK_ENV=test
PAYSTACK_SECRET_KEY=
PAYSTACK_PUBLIC_KEY=
PAYSTACK_BASE_URL=https://api.paystack.co
PAYSTACK_WEBHOOK_SECRET=

# S3 / Object Storage
S3_ENDPOINT=
S3_REGION=eu-west-1
S3_BUCKET=ogun-documents
S3_ACCESS_KEY_ID=
S3_SECRET_ACCESS_KEY=

# Google Document AI (§4.2.1 — Layer 1 extraction)
# Leave GOOGLE_DOCUMENTAI_PROJECT_ID blank to use the deterministic stub.
# When enabled, the adapter sends each uploaded document to the Form
# Parser processor (or per-type processors if configured).
GOOGLE_DOCUMENTAI_PROJECT_ID=
GOOGLE_DOCUMENTAI_LOCATION=us
GOOGLE_DOCUMENTAI_PROCESSOR_ID=
# Optional per-document-type processor overrides
GOOGLE_DOCUMENTAI_PROCESSOR_COR=
GOOGLE_DOCUMENTAI_PROCESSOR_TAX=
GOOGLE_DOCUMENTAI_PROCESSOR_ID_DOC=
GOOGLE_DOCUMENTAI_PROCESSOR_BANK=
# Credentials — either a path to a service account JSON file OR the
# inline JSON contents. If neither is set, the Google Cloud default
# auth chain is used (useful when running on GKE / Cloud Run).
GOOGLE_APPLICATION_CREDENTIALS=
GOOGLE_APPLICATION_CREDENTIALS_JSON=

# Email (SendGrid / SES)
EMAIL_PROVIDER=sendgrid
SENDGRID_API_KEY=
EMAIL_FROM=noreply@ogun.com

# Platform Secrets
OGUN_WEBHOOK_SIGNING_SALT=replace-me-with-random-salt
OGUN_IDEMPOTENCY_TTL_SECONDS=86400

# Polling Configuration
COLLECTION_POLL_INTERVAL_SECONDS=5
COLLECTION_POLL_TTL_SECONDS=300
